{
  "type": "mod",
  "id": "nox.settings",
  "provides": [
    "fr.hactazia.sdk.settings",
    "settings"
  ],
  "name": "Settings",
  "version": "1.0.0",
  "description": "Provides the Settings for the game.",
  "license": "GPL-3.0",
  "icon": null,
  "contact": {
    "email": "hactazia@gmail.com",
    "source": "https://github.com/AtelierVR/nox.settings",
    "website": "https://nox.hactazia.fr/",
    "issues": "https://github.com/AtelierVR/nox.settings/issues"
  },
  "authors": [
    {
      "name": "Hactazia",
      "email": "hactazia@gmail.com",
      "website": "https://hactazia.fr/"
    }
  ],
  "relations": [
    {
      "id": "ui",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.ui.git"
    },
    {
      "id": "controller",
      "type": "recommends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.controllers.git"
    },
    {
      "id": "com.unity.render-pipelines.universal",
      "type": "depends",
      "version": ">=17.0.0",
      "register": "upm+com.unity.render-pipelines.universal@17.5.0"
    },
    {
      "id": "terminal",
      "type": "depends",
      "version": ">=1.0.0"
    }
  ],
  "constraints": [
    {
      "type": "after",
      "id": "ui"
    }
  ],
  "entrypoints": {
    "main": [
      "Nox.Settings.Runtime.Main"
    ],
    "client": [
      "Nox.Settings.Clients.Client"
    ]
  }
}